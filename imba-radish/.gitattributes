# ===== 兜底：统一仓库和检出都用 LF =====
* text=auto eol=lf

# ===== 脚本 =====
*.sh   text eol=lf
*.bash text eol=lf
*.zsh  text eol=lf
*.fish text eol=lf
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# ===== Java / Maven / Gradle =====
*.java       text diff=java
*.kt         text diff=kotlin
*.groovy     text
*.xml        text
*.yml        text
*.yaml       text
*.properties text
*.sql        text
*.json       text
*.md         text diff=markdown
*.gradle     text
*.gradle.kts text
pom.xml      text eol=lf

# ===== 文本格式的图片，可 diff 可合并 =====
*.svg text

