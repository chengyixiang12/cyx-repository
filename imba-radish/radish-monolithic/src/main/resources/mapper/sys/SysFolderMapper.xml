<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.soft.sys.mapper.SysFolderMapper">

    <select id="countFilesInFolders" resultType="com.soft.sys.model.dto.FolderFileCountDTO">
        SELECT
        sf.folder_id AS folderId,
        COUNT(*) AS cnt
        FROM
        sys_file sf
        WHERE
        sf.del_flag = '0'
        AND sf.folder_id IN
        <foreach collection="folderIds" item="folderId" open="(" separator="," close=")">
            #{folderId}
        </foreach>
        GROUP BY sf.folder_id
    </select>
</mapper>
